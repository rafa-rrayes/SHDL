component DLatch(D, EN) -> (Q, Qn) {
    inv: NOT;
    gSet: AND;
    gRst: AND;
    latch_n1_o1: OR;
    latch_n1_n1: NOT;
    latch_n2_o1: OR;
    latch_n2_n1: NOT;

    connect {
        gRst.O -> latch_n1_o1.A;
        latch_n2_n1.O -> latch_n1_o1.B;
        latch_n1_o1.O -> latch_n1_n1.A;
        gSet.O -> latch_n2_o1.A;
        latch_n1_n1.O -> latch_n2_o1.B;
        latch_n2_o1.O -> latch_n2_n1.A;
        D -> inv.A;
        D -> gSet.A;
        EN -> gSet.B;
        inv.O -> gRst.A;
        EN -> gRst.B;
        latch_n1_n1.O -> Q;
        latch_n2_n1.O -> Qn;
    }
}

