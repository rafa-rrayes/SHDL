component AdderN(A_1_, A_2_, A_3_, A_4_, B_1_, B_2_, B_3_, B_4_, Cin) -> (Sum_1_, Sum_2_, Sum_3_, Sum_4_, Cout) {
    fa1_x1: XOR;
    fa1_a1: AND;
    fa1_x2: XOR;
    fa1_a2: AND;
    fa1_o1: OR;
    fa2_x1: XOR;
    fa2_a1: AND;
    fa2_x2: XOR;
    fa2_a2: AND;
    fa2_o1: OR;
    fa3_x1: XOR;
    fa3_a1: AND;
    fa3_x2: XOR;
    fa3_a2: AND;
    fa3_o1: OR;
    fa4_x1: XOR;
    fa4_a1: AND;
    fa4_x2: XOR;
    fa4_a2: AND;
    fa4_o1: OR;

    connect {
        A_1_ -> fa1_x1.A;
        B_1_ -> fa1_x1.B;
        A_1_ -> fa1_a1.A;
        B_1_ -> fa1_a1.B;
        fa1_x1.O -> fa1_x2.A;
        Cin -> fa1_x2.B;
        fa1_x1.O -> fa1_a2.A;
        Cin -> fa1_a2.B;
        fa1_a1.O -> fa1_o1.A;
        fa1_a2.O -> fa1_o1.B;
        A_2_ -> fa2_x1.A;
        B_2_ -> fa2_x1.B;
        A_2_ -> fa2_a1.A;
        B_2_ -> fa2_a1.B;
        fa2_x1.O -> fa2_x2.A;
        fa1_o1.O -> fa2_x2.B;
        fa2_x1.O -> fa2_a2.A;
        fa1_o1.O -> fa2_a2.B;
        fa2_a1.O -> fa2_o1.A;
        fa2_a2.O -> fa2_o1.B;
        A_3_ -> fa3_x1.A;
        B_3_ -> fa3_x1.B;
        A_3_ -> fa3_a1.A;
        B_3_ -> fa3_a1.B;
        fa3_x1.O -> fa3_x2.A;
        fa2_o1.O -> fa3_x2.B;
        fa3_x1.O -> fa3_a2.A;
        fa2_o1.O -> fa3_a2.B;
        fa3_a1.O -> fa3_o1.A;
        fa3_a2.O -> fa3_o1.B;
        A_4_ -> fa4_x1.A;
        B_4_ -> fa4_x1.B;
        A_4_ -> fa4_a1.A;
        B_4_ -> fa4_a1.B;
        fa4_x1.O -> fa4_x2.A;
        fa3_o1.O -> fa4_x2.B;
        fa4_x1.O -> fa4_a2.A;
        fa3_o1.O -> fa4_a2.B;
        fa4_a1.O -> fa4_o1.A;
        fa4_a2.O -> fa4_o1.B;
        fa1_x2.O -> Sum_1_;
        fa2_x2.O -> Sum_2_;
        fa3_x2.O -> Sum_3_;
        fa4_x2.O -> Sum_4_;
        fa4_o1.O -> Cout;
    }
}

