component Diamond(A, B) -> (Na, No) {
    g1_a: AND;
    g1_i_n: NOT;
    g2_o: OR;
    g2_i_n: NOT;

    connect {
        g1_a.O -> g1_i_n.A;
        A -> g1_a.A;
        B -> g1_a.B;
        g2_o.O -> g2_i_n.A;
        A -> g2_o.A;
        B -> g2_o.B;
        g1_i_n.O -> Na;
        g2_i_n.O -> No;
    }
}

