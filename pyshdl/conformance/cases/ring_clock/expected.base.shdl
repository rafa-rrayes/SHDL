component RingClock(seed) -> (out_1_, out_2_, out_3_, out_4_, out_5_, out_6_, out_7_, out_8_) {
    buf1: OR;
    buf2: OR;
    buf3: OR;
    buf4: OR;
    buf5: OR;
    buf6: OR;
    buf7: OR;
    buf8: OR;

    connect {
        seed -> buf1.A;
        buf1.O -> buf2.A;
        buf1.O -> buf2.B;
        buf2.O -> buf3.A;
        buf2.O -> buf3.B;
        buf3.O -> buf4.A;
        buf3.O -> buf4.B;
        buf4.O -> buf5.A;
        buf4.O -> buf5.B;
        buf5.O -> buf6.A;
        buf5.O -> buf6.B;
        buf6.O -> buf7.A;
        buf6.O -> buf7.B;
        buf7.O -> buf8.A;
        buf7.O -> buf8.B;
        buf8.O -> buf1.B;
        buf1.O -> out_1_;
        buf2.O -> out_2_;
        buf3.O -> out_3_;
        buf4.O -> out_4_;
        buf5.O -> out_5_;
        buf6.O -> out_6_;
        buf7.O -> out_7_;
        buf8.O -> out_8_;
    }
}

