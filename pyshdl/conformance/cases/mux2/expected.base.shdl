component Mux2(A, B, S) -> (O) {
    inv: NOT;
    gA: AND;
    gB: AND;
    o1: OR;

    connect {
        S -> inv.A;
        A -> gA.A;
        inv.O -> gA.B;
        B -> gB.A;
        S -> gB.B;
        gA.O -> o1.A;
        gB.O -> o1.B;
        o1.O -> O;
    }
}

