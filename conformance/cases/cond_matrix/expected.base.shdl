component CondMatrix(P, Q) -> (Out_1_, Out_2_, Out_3_, Out_4_, Out_5_, Out_6_) {
    z: __GND__;
    lane1: OR;
    lane2: OR;
    lane3: OR;
    lane4: OR;
    lane5: OR;
    lane6: OR;

    connect {
        P -> lane1.A;
        z.O -> lane1.B;
        lane1.O -> Out_1_;
        Q -> lane2.A;
        z.O -> lane2.B;
        lane2.O -> Out_2_;
        P -> lane3.A;
        z.O -> lane3.B;
        lane3.O -> Out_3_;
        P -> lane4.A;
        z.O -> lane4.B;
        lane4.O -> Out_4_;
        Q -> lane5.A;
        z.O -> lane5.B;
        lane5.O -> Out_5_;
        Q -> lane6.A;
        z.O -> lane6.B;
        lane6.O -> Out_6_;
    }
}

