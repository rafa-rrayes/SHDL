"""
02 -- stdgates: the conventional standard-library module (shdl.md §9.2).

NAND, NOR, and XNOR are not primitives -- they are ordinary components
composed from the built-in types (AND, OR, NOT, XOR) and inlined like
any other component during flattening.

This module is a library: it deliberately has no `top` marker.  Later
examples pull gates from it with

    use stdgates::{NAND, NOR, XNOR};

To flatten one of them directly, pick it explicitly:

    shdl-flatten examples/stdgates.shdl --top NAND
"""

component NAND(A, B) -> (O) {
    a1: AND;  n1: NOT;
    connect { A -> a1.A;  B -> a1.B;  a1.O -> n1.A;  n1.O -> O; }
}

component NOR(A, B) -> (O) {
    o1: OR;  n1: NOT;
    connect { A -> o1.A;  B -> o1.B;  o1.O -> n1.A;  n1.O -> O; }
}

component XNOR(A, B) -> (O) {
    x1: XOR;  n1: NOT;
    connect { A -> x1.A;  B -> x1.B;  x1.O -> n1.A;  n1.O -> O; }
}
