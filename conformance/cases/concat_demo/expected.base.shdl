component ConcatDemo(In_1_, In_2_, In_3_, In_4_, Sign) -> (Word_1_, Word_2_, Word_3_, Word_4_, Ext_1_, Ext_2_, Ext_3_, Ext_4_, Ext_5_, Ext_6_, High_1_, High_2_, Low_1_, Low_2_, X) {
    x1: XOR;

    connect {
        In_4_ -> Word_4_;
        In_3_ -> Word_3_;
        In_2_ -> Word_2_;
        In_1_ -> Word_1_;
        Sign -> Ext_6_;
        Sign -> Ext_5_;
