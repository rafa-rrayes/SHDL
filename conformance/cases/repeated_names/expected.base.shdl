component RepeatedNames(A) -> (O) {
    c1_g: NOT;
    c2_g: NOT;
    g: NOT;

    connect {
        A -> c1_g.A;
        c1_g.O -> c2_g.A;
        c2_g.O -> g.A;
        g.O -> O;
    }
}

