component SRLatch(S, R) -> (Q, Qn) {
    n1_o1: OR;
    n1_n1: NOT;
    n2_o1: OR;
    n2_n1: NOT;

    connect {
        R -> n1_o1.A;
        n2_n1.O -> n1_o1.B;
        n1_o1.O -> n1_n1.A;
        S -> n2_o1.A;
        n1_n1.O -> n2_o1.B;
        n2_o1.O -> n2_n1.A;
        n1_n1.O -> Q;
        n2_n1.O -> Qn;
    }
}

