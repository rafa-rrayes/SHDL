component DegenSlice(In_1_, In_2_, In_3_) -> (Out_1_, Out_2_, Out_3_) {
    b1: OR;
    b2: OR;
    b3: OR;

    connect {
        In_3_ -> b1.A;
        In_3_ -> b1.B;
        b1.O -> Out_1_;
        In_1_ -> b2.A;
        In_1_ -> b2.B;
        b2.O -> Out_2_;
        In_2_ -> b3.A;
        In_2_ -> b3.B;
        b3.O -> Out_3_;
    }
}

