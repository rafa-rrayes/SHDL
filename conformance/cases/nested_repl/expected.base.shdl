component NestedRepl(In_1_, In_2_, Sign) -> (Word_1_, Word_2_, Word_3_, Word_4_, Word_5_, Word_6_, Word_7_, Word_8_) {
    connect {
        Sign -> Word_8_;
        Sign -> Word_7_;
        Sign -> Word_6_;
        Sign -> Word_5_;
        Sign -> Word_4_;
        Sign -> Word_3_;
        In_2_ -> Word_2_;
        In_1_ -> Word_1_;
    }
}

