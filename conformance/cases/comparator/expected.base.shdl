component EqualN(A_1_, A_2_, A_3_, A_4_, A_5_, A_6_, A_7_, A_8_, B_1_, B_2_, B_3_, B_4_, B_5_, B_6_, B_7_, B_8_) -> (EQ) {
    eq1_x1: XOR;
    eq1_n1: NOT;
    eq2_x1: XOR;
    eq2_n1: NOT;
    eq3_x1: XOR;
    eq3_n1: NOT;
    eq4_x1: XOR;
    eq4_n1: NOT;
    eq5_x1: XOR;
    eq5_n1: NOT;
    eq6_x1: XOR;
    eq6_n1: NOT;
    eq7_x1: XOR;
    eq7_n1: NOT;
    eq8_x1: XOR;
    eq8_n1: NOT;
    red2: AND;
    red3: AND;
    red4: AND;
    red5: AND;
    red6: AND;
    red7: AND;
    red8: AND;

    connect {
        A_1_ -> eq1_x1.A;
        B_1_ -> eq1_x1.B;
        eq1_x1.O -> eq1_n1.A;
        A_2_ -> eq2_x1.A;
        B_2_ -> eq2_x1.B;
        eq2_x1.O -> eq2_n1.A;
        A_3_ -> eq3_x1.A;
        B_3_ -> eq3_x1.B;
        eq3_x1.O -> eq3_n1.A;
        A_4_ -> eq4_x1.A;
        B_4_ -> eq4_x1.B;
        eq4_x1.O -> eq4_n1.A;
        A_5_ -> eq5_x1.A;
        B_5_ -> eq5_x1.B;
        eq5_x1.O -> eq5_n1.A;
        A_6_ -> eq6_x1.A;
        B_6_ -> eq6_x1.B;
        eq6_x1.O -> eq6_n1.A;
        A_7_ -> eq7_x1.A;
        B_7_ -> eq7_x1.B;
        eq7_x1.O -> eq7_n1.A;
        A_8_ -> eq8_x1.A;
        B_8_ -> eq8_x1.B;
        eq8_x1.O -> eq8_n1.A;
        eq1_n1.O -> red2.A;
        eq2_n1.O -> red2.B;
        red2.O -> red3.A;
        eq3_n1.O -> red3.B;
        red3.O -> red4.A;
        eq4_n1.O -> red4.B;
        red4.O -> red5.A;
        eq5_n1.O -> red5.B;
        red5.O -> red6.A;
        eq6_n1.O -> red6.B;
        red6.O -> red7.A;
        eq7_n1.O -> red7.B;
        red7.O -> red8.A;
        eq8_n1.O -> red8.B;
        red8.O -> EQ;
    }
}

