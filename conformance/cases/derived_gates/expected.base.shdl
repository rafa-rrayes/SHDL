component GatesDemo(A, B) -> (Na, No, Xn) {
    g1_a1: AND;
    g1_n1: NOT;
    g2_o1: OR;
    g2_n1: NOT;
    g3_x1: XOR;
    g3_n1: NOT;

    connect {
        A -> g1_a1.A;
        B -> g1_a1.B;
        g1_a1.O -> g1_n1.A;
        A -> g2_o1.A;
        B -> g2_o1.B;
        g2_o1.O -> g2_n1.A;
        A -> g3_x1.A;
        B -> g3_x1.B;
        g3_x1.O -> g3_n1.A;
        g1_n1.O -> Na;
        g2_n1.O -> No;
        g3_n1.O -> Xn;
    }
}

