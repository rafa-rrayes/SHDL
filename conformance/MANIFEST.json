  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-06-10",
      "notes": "Initial corpus: 32 cases covering all primitives, derived gates, adders (with per-cycle carry ripple), state/feedback, language features at multiple bindings, large composites, degenerate shapes, and the seven release-ABI semantics rules."
    },
    {
      "version": "1.1.0",
      "date": "2026-06-12",
      "notes": "Additive (CNF-4): six new cases — nested_repl (nested replication 2{3{x}}), diamond (a leaf reached via two import paths, program-global module identity), degen_slice (single-element slice S[k:k]), deep_hier (five-level instantiation chain over one NOT), init_comb (transient, reset-restored init seed on a feedback-free gate, witnessing AMB-3/AMB-39 power-on state), and cond_matrix (every when-condition operator at flatten time). Eight new required features cover them. No existing golden byte changed; flatten_timestamp unchanged."
    }
  ],
